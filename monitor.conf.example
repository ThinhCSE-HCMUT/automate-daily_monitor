# Copy to monitor.conf on the Pi (chmod 600). monitor.conf is gitignored.

lab_ssid_5g=Simplifi Lab 5Ghz
lab_ssid_24g=Simplifi Lab 2.4Ghz
lab_password=

wifi_iface=wlan0
router_gateway=192.168.2.1
router_gateway_alt=192.168.10.1
ssh_user=root

wifi_timeout_sec=45
ssh_timeout_sec=45

output_csv=output/daily_monitor.csv
log_file=output/monitor.log

portal_logs=1
portal_conf=portal.conf
fax_send=1
fax_conf=fax.conf
laptop_sync=1
laptop_host=voicelink
sharepoint_excel=1
sharepoint_conf=sharepoint.conf

# US Windows jump laptop (same Tailscale tailnet as the Pi)
jump_host=100.109.148.118
jump_user=simplifi
jump_restore_ssid=
jump_wait_sec=600

